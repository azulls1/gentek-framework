{
  "name": "@iagentek/core",
  "version": "0.3.2",
  "description": "Núcleo de IAgentek — providers de IA, orchestrator de fases y sistema de checkpoints",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "node ../../scripts/sync-license.mjs && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@iagentek/method": "0.3.2",
    "@google/generative-ai": "^0.21.0",
    "js-yaml": "^4.1.0",
    "kleur": "^4.1.5",
    "openai": "^4.65.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "license": "MIT",
  "author": "azulls1 <azull.samael@gmail.com>",
  "homepage": "https://github.com/azulls1/iagentek-framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azulls1/iagentek-framework.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/azulls1/iagentek-framework/issues"
  },
  "keywords": [
    "ai",
    "framework",
    "bmad",
    "spec-driven",
    "anthropic",
    "openai",
    "gemini",
    "deepseek",
    "ollama",
    "orchestrator"
  ],
  "publishConfig": {
    "access": "public"
  }
}

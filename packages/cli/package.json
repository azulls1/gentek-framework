{
  "name": "@gentek/cli",
  "version": "0.1.0",
  "description": "CLI npx-ejecutable para el framework Gentek (SDD + BMAD)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gentek": "./dist/bin/gentek.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-bin-shebang.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/gentek.js",
    "prepublishOnly": "node ../../scripts/sync-license.mjs && npm run build"
  },
  "dependencies": {
    "@gentek/core": "0.1.0",
    "@gentek/method": "0.1.0",
    "commander": "^12.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  },
  "license": "MIT",
  "author": "azulls1 <azull.samael@gmail.com>",
  "homepage": "https://github.com/azulls1/gentek-framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azulls1/gentek-framework.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/azulls1/gentek-framework/issues"
  },
  "keywords": [
    "ai",
    "framework",
    "bmad",
    "spec-driven",
    "claude",
    "openai",
    "gemini",
    "autonomous",
    "agents",
    "cli",
    "npx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}

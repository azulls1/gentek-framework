{
  "name": "@gentek/cli",
  "version": "0.1.0",
  "description": "CLI npx-ejecutable para el framework Gentek (SDD + BMAD)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gentek": "./dist/bin/gentek.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-bin-shebang.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/gentek.js"
  },
  "dependencies": {
    "@gentek/core": "0.1.0",
    "@gentek/method": "0.1.0",
    "commander": "^12.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  }
}

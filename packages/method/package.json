{
  "name": "@gentek/method",
  "version": "0.3.0",
  "description": "Agentes BMAD + plantillas Spec-Driven Development para Gentek",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node ../../scripts/copy-assets.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "node ../../scripts/sync-license.mjs && npm run build"
  },
  "license": "MIT",
  "author": "azulls1 <azull.samael@gmail.com>",
  "homepage": "https://github.com/azulls1/gentek-framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azulls1/gentek-framework.git",
    "directory": "packages/method"
  },
  "bugs": {
    "url": "https://github.com/azulls1/gentek-framework/issues"
  },
  "keywords": [
    "bmad",
    "spec-driven",
    "agents",
    "templates",
    "markdown"
  ],
  "publishConfig": {
    "access": "public"
  }
}

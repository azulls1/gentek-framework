{
  "name": "@gentek/method",
  "version": "0.1.0",
  "description": "Agentes BMAD + plantillas Spec-Driven Development para Gentek",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node ../../scripts/copy-assets.mjs",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "license": "MIT"
}

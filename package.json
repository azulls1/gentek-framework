{
  "name": "iagentek",
  "version": "0.3.1",
  "private": true,
  "description": "Framework de desarrollo autónomo asistido por IA — fusiona Spec-Driven Development con BMAD Method",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @iagentek/method && npm run build -w @iagentek/core && npm run build -w @iagentek/cli",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules",
    "dev": "npm run dev --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build",
    "sync:license": "node scripts/sync-license.mjs",
    "prepublish:all": "npm run sync:license && npm run build && npm test",
    "cli": "node packages/cli/dist/bin/iagentek.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "ai",
    "framework",
    "bmad",
    "spec-driven",
    "claude",
    "autonomous",
    "agents"
  ],
  "license": "MIT"
}
